# --- Paltoo environment configuration ---
# Copy to .env and fill in real values. Never commit .env.

# App
APP_ENV=development            # development | production
DEBUG=false

# Security — CRITICAL: set a long random value in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440      # 24 hours

# Database
# Dev (SQLite):  sqlite:///./paltoo.db
# Prod (Postgres): postgresql+psycopg2://paltoo:password@db:5432/paltoo
DATABASE_URL=sqlite:///./paltoo.db

# CORS — comma-separated origins, e.g. https://paltoo.vercel.app
CORS_ORIGINS=*

# Rate limits (slowapi syntax)
RATE_REGISTER=5/minute
RATE_LOGIN=10/minute
RATE_DEFAULT=60/minute

# Clinic / booking rules
SLOT_MINUTES=30
CLINIC_OPEN_HOUR=10            # 10:00 AM
CLINIC_CLOSE_HOUR=20           # 8:00 PM
BOOKING_DAYS_AHEAD=14

# --- Demo accounts (seeded in development only) ---
# admin@paltoo.pk / admin12345   (Platform Admin)
# vet@paltoo.pk / vet12345       (Dr. Ayesha Khan — verified vet, Karachi)